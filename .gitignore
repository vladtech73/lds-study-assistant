# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Env / secrets
.env
*.pem

# Local model weights & caches (keep directory markers only)
models/**
!models/.gitkeep
*.gguf
*.bin
*.safetensors
.cache/
huggingface/

# Pipeline outputs (indexes never committed; eval reports under outputs/eval/ are)
indexes/**
!indexes/.gitkeep
outputs/**
!outputs/.gitkeep
!outputs/eval/
!outputs/eval/**/
!outputs/eval/.gitkeep
!outputs/eval/**/*.md
!outputs/eval/**/*.summary.json
adapters/

# Local-only golden questions over restricted / BYOF sources (never commit).
eval/golden.local.yaml

# Personal-use tooling only (local Conference fetch, etc.). Never commit.
private/

# Data: ignore everything under data/, then allow structural files only
data/**
!data/**/
!data/**/.gitkeep
!data/README.md
!data/raw/user/EXAMPLE.meta.json

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
