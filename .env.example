# Copy to .env and adjust. Never commit .env.
# LDS_STUDY_ROOT: optional absolute path to the project/data root.
# If unset, the package derives the repo root from its install location.

LDS_STUDY_ROOT=
LDS_STUDY_DATA_DIR=data
LDS_STUDY_INDEX_DIR=indexes
LDS_STUDY_MODELS_DIR=models
LDS_STUDY_OUTPUTS_DIR=outputs

# Ollama host (default local)
LDS_STUDY_OLLAMA_HOST=http://127.0.0.1:11434
