# Copy to .env and adjust. Never commit .env.
#
# Optional: absolute path to the project/data root.
# Leave unset (or keep this line commented) to derive the root from the package install.
# Do NOT set LDS_STUDY_ROOT= to an empty value — blank used to be coerced to Path('.').
# LDS_STUDY_ROOT=D:/path/to/lds-study-assistant

LDS_STUDY_DATA_DIR=data
LDS_STUDY_INDEX_DIR=indexes
LDS_STUDY_MODELS_DIR=models
LDS_STUDY_OUTPUTS_DIR=outputs

# Ollama host (default local)
LDS_STUDY_OLLAMA_HOST=http://127.0.0.1:11434
